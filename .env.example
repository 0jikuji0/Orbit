# Connexion PostgreSQL (dev : docker-compose.dev.yml)
DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit?schema=public"

# URL publique de l'application (sans slash final)
BETTER_AUTH_URL="http://localhost:3000"

# Secret de signature des sessions, 32 caractères minimum.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production-please-32chars"

# Dossier des pièces jointes (défaut : ./data/uploads). En production : un volume Docker.
# UPLOAD_DIR="/data/uploads"
