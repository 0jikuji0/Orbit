# ════════════════════════════════════════════════════════════════════════
#  Orbit — configuration. Copier en `.env` puis compléter.
# ════════════════════════════════════════════════════════════════════════

# ─── Production (docker compose up -d) ──────────────────────────────────

# Nom de domaine public (sans https://). Son DNS doit pointer vers le serveur.
# Pour un essai local : ORBIT_DOMAIN=localhost (certificat auto-signé).
ORBIT_DOMAIN="orbit.example.com"

# E-mail transmis à Let's Encrypt (avertissements avant expiration du certificat).
ACME_EMAIL="admin@example.com"

# Mot de passe de la base PostgreSQL. Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD="change-me"

# Secret de signature des sessions, 32 caractères minimum.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production-please-32chars"

# ─── Développement local (pnpm dev) ─────────────────────────────────────
# Ignorées par docker compose, qui construit ses propres valeurs ci-dessus.

# Base lancée par `pnpm db:up` (docker-compose.dev.yml).
DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit?schema=public"

# URL de l'application en développement (sans slash final).
BETTER_AUTH_URL="http://localhost:3000"

# Dossier des pièces jointes (défaut : ./data/uploads). Dans Docker : /data/uploads (volume).
# UPLOAD_DIR="/data/uploads"
